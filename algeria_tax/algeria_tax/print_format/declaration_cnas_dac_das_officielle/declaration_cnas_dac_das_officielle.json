  "doc_type": "CNAS Declaration",
  "docstatus": 0,
  "doctype": "Print Format",
  "font_size": 12,
  "html": "<div style=\"font-family:'Inter',Arial,sans-serif; padding:20px; border:2px solid #0f172a;\">\n            <div style=\"display:flex; justify-content:space-between; border-bottom:2px solid #0f172a; padding-bottom:10px;\">\n                <div>\n                    <h2 style=\"margin:0; color:#1e3a8a;\">CAISSE NATIONALE DES ASSURANCES SOCIALES (CNAS)</h2>\n                    <div>الصندوق الوطني للتأمينات الاجتماعية للعمال الأجراء</div>\n                    <div><b>{{ doc.declaration_type }}</b> — Réf : {{ doc.name }}</div>\n                </div>\n                <div style=\"text-align:right;\">\n                    <div><b>Employeur :</b> {{ doc.company }}</div>\n                    <div><b>N° Adhérent CNAS :</b> {{ doc.numero_employeur_cnas }}</div>\n                    <div><b>Période :</b> {{ doc.period_label }} ({{ doc.fiscal_year }})</div>\n                </div>\n            </div>\n            <table style=\"width:100%; border-collapse:collapse; margin-top:16px; font-size:12px;\">\n                <thead>\n                    <tr style=\"background:#1e3a8a; color:#fff;\">\n                        <th style=\"padding:6px; border:1px solid #cbd5e1;\">Salarié</th>\n                        <th style=\"padding:6px; border:1px solid #cbd5e1;\">NSS (12 chiffres)</th>\n                        <th style=\"padding:6px; border:1px solid #cbd5e1;\">Jours</th>\n                        <th style=\"padding:6px; border:1px solid #cbd5e1; text-align:right;\">Assiette CNAS</th>\n                        <th style=\"padding:6px; border:1px solid #cbd5e1; text-align:right;\">Part Salarié 9%</th>\n                        <th style=\"padding:6px; border:1px solid #cbd5e1; text-align:right;\">Part Patronale 26%</th>\n                        <th style=\"padding:6px; border:1px solid #cbd5e1; text-align:right;\">Total 35%</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    {% for row in doc.employees %}\n                    <tr>\n                        <td style=\"padding:6px; border:1px solid #cbd5e1;\">{{ row.employee_name }}</td>\n                        <td style=\"padding:6px; border:1px solid #cbd5e1; font-family:monospace;\">{{ row.nss_cnas }}</td>\n                        <td style=\"padding:6px; border:1px solid #cbd5e1; text-align:center;\">{{ row.working_days }}</td>\n                        <td style=\"padding:6px; border:1px solid #cbd5e1; text-align:right;\">{{ \"{:,.2f}\".format(row.assiette_cnas or 0) }}</td>\n                        <td style=\"padding:6px; border:1px solid #cbd5e1; text-align:right;\">{{ \"{:,.2f}\".format(row.cnas_salarie_9 or 0) }}</td>\n                        <td style=\"padding:6px; border:1px solid #cbd5e1; text-align:right;\">{{ \"{:,.2f}\".format(row.cnas_employeur_26 or 0) }}</td>\n                        <td style=\"padding:6px; border:1px solid #cbd5e1; text-align:right; font-weight:700;\">{{ \"{:,.2f}\".format(row.total_cnas_35 or 0) }}</td>\n                    </tr>\n                    {% endfor %}\n                </tbody>\n                <tfoot>\n                    <tr style=\"background:#f1f5f9; font-weight:700;\">\n                        <td colspan=\"3\" style=\"padding:8px; border:1px solid #cbd5e1;\">TOTAUX ({{ doc.effectif_declare }} salariés)</td>\n                        <td style=\"padding:8px; border:1px solid #cbd5e1; text-align:right;\">{{ \"{:,.2f}\".format(doc.total_assiette_cnas or 0) }} DZD</td>\n                        <td style=\"padding:8px; border:1px solid #cbd5e1; text-align:right;\">{{ \"{:,.2f}\".format(doc.total_part_salariale_9 or 0) }} DZD</td>\n                        <td style=\"padding:8px; border:1px solid #cbd5e1; text-align:right;\">{{ \"{:,.2f}\".format(doc.total_part_patronale_26 or 0) }} DZD</td>\n                        <td style=\"padding:8px; border:1px solid #cbd5e1; text-align:right; color:#1e3a8a;\">{{ \"{:,.2f}\".format(doc.total_cotisations_35 or 0) }} DZD</td>\n                    </tr>\n                </tfoot>\n            </table>\n        </div>",
